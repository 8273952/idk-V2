	getgenv().PPReachSlider = Options.PromptReachSlider.Value
end)



PPGroupBox:AddToggle("PromptReachToggle", {
	Text = "Prompt Reach",
	Tooltip = "Increases prompt activation distance", -- Information shown when you hover over the toggle
	DisabledTooltip = "Increases prompt activation distance", -- Information shown when you hover over the toggle while it's disabled

	Default = false, -- Default value (true / false)
	Disabled = false, -- Will disable the toggle (true / false)
	Visible = true, -- Will make the toggle invisible (true / false)
	Risky = false, -- Makes the text red (the color can be changed using Library.Scheme.Red) (Default value = false)

	Callback = function(Value)
		
	end,
})



local PromptDescendantChecker
Toggles.PromptReachToggle:OnChanged(function()
	if Toggles.PromptReachToggle.Value then
		for _, prompt in ipairs(Rooms:GetDescendants()) do
			if prompt:IsA("ProximityPrompt") then
				prompt:SetAttribute("OldMAD", prompt.MaxActivationDistance)
				prompt.MaxActivationDistance = prompt.MaxActivationDistance + getgenv().PPReachSlider
			end
		end

		PromptDescendantChecker = Rooms.DescendantAdded:Connect(function(prompt)
			if prompt:IsA("ProximityPrompt") then
				prompt:SetAttribute("OldMAD", prompt.MaxActivationDistance)
				prompt.MaxActivationDistance = prompt.MaxActivationDistance + getgenv().PPReachSlider
			end
		end)
	else
		if PromptDescendantChecker then
			PromptDescendantChecker:Disconnect()
			PromptDescendantChecker = nil
		end

		for _, prompt in ipairs(Rooms:GetDescendants()) do
			if prompt:IsA("ProximityPrompt") then
				if prompt:GetAttribute("OldMAD") ~= nil then
					prompt.MaxActivationDistance = prompt:GetAttribute("OldMAD")
					prompt:SetAttribute("OldMAD", nil)
				end
			end
		end
	end
end)



PPGroupBox:AddToggle("ClipPromptToggle", {
	Text = "Clip prompt",
	Tooltip = "Lets you activate prompts through walls", -- Information shown when you hover over the toggle
	DisabledTooltip = "Lets you activate prompts through walls", -- Information shown when you hover over the toggle while it's disabled

	Default = false, -- Default value (true / false)
	Disabled = false, -- Will disable the toggle (true / false)
	Visible = true, -- Will make the toggle invisible (true / false)
	Risky = false, -- Makes the text red (the color can be changed using Library.Scheme.Red) (Default value = false)

	Callback = function(Value)
		
	end,
})



local PromptDescendantChecker1
Toggles.ClipPromptToggle:OnChanged(function()
	if Toggles.ClipPromptToggle.Value then
		for _, prompt in ipairs(Rooms:GetDescendants()) do
			if prompt:IsA("ProximityPrompt") then
				prompt:SetAttribute("OldRLOS", prompt.RequiresLineOfSight)
				prompt.RequiresLineOfSight = false
			end
		end

		PromptDescendantChecker1 = Rooms.DescendantAdded:Connect(function(prompt)
			if prompt:IsA("ProximityPrompt") then
				prompt:SetAttribute("OldRLOS", prompt.RequiresLineOfSight)
				prompt.RequiresLineOfSight = false
			end
		end)
	else
		if PromptDescendantChecker1 then
			PromptDescendantChecker1:Disconnect()
			PromptDescendantChecker1 = nil
		end

		for _, prompt in ipairs(Rooms:GetDescendants()) do
			if prompt:IsA("ProximityPrompt") then
				if prompt:GetAttribute("OldRLOS") ~= nil then
					prompt.RequiresLineOfSight = prompt:GetAttribute("OldRLOS")
					prompt:SetAttribute("OldRLOS", nil)
				else
					prompt.RequiresLineOfSight = true
				end
			end
		end
	end
end)



local function highlight(Door)
	if not Door.Parent:FindFirstChild("hModel") then
		local Model = Instance.new("Model")
		Model.Name = "hModel"
		Model.Parent = Door.Parent

		local humanoid = Instance.new("Humanoid")
		humanoid.Name = "hHum"
		humanoid.Parent = Model

		local hPart = Instance.new("Part")
		hPart.Size = Door.Size
		hPart.CFrame = Door.CFrame
		hPart.Transparency = 0.99
		hPart.CanCollide = false
		hPart.Name = "hPart"
		hPart.Parent = Model

		local weld = Instance.new("Weld")
        weld.Part0 = Door
        weld.Part1 = hPart
        weld.C0 = CFrame.new(0, 0, 0)
        weld.Parent = hPart

		local RoomID = Door.Parent:GetAttribute("RoomID")
		ESPLibrary:AddESP({
			Object = hPart,
			Text = Door.Parent.Name .. "[" .. RoomID .. "]",
			Color = Color3.fromRGB(0, 255, 255)
		})
	end
end



ESPGroupBox:AddToggle("DoorESPToggle", {
	Text = "Door ESP",
	Default = false, -- Default value (true / false)
	Disabled = false, -- Will disable the toggle (true / false)
	Visible = true, -- Will make the toggle invisible (true / false)
	Risky = false, -- Makes the text red (the color can be changed using Library.Scheme.Red) (Default value = false)

	Callback = function(Value)
		
	end,
})


local DoorDescendantChecker
Toggles.DoorESPToggle:OnChanged(function()
	if Toggles.DoorESPToggle.Value then
		for _, Door in ipairs(Rooms:GetDescendants()) do
			if Door.Name == "Door" and Door.Parent.Name == "Door" then
				highlight(Door)
			end
		end

		DoorDescendantChecker = Rooms.DescendantAdded:Connect(function(Door)
			if Door.Name == "Door" and Door.Parent.Name == "Door" then
				highlight(Door)
			end
		end)
	else
		if DoorDescendantChecker then
			DoorDescendantChecker:Disconnect()
			DoorDescendantChecker = nil
		end

		for _, Door in ipairs(Rooms:GetDescendants()) do
			if Door.Name == "Door" and Door.Parent.Name == "Door" then
				local Model = Door.Parent:FindFirstChild("hModel")

				if Model then
					local hPart = Model:FindFirstChild("hPart")
					if hPart then
						ESPLibrary:RemoveESP(hPart)
					end
				end
				if Model then
					Model:Destroy()
				end
			end
		end
	end
end)



