local ESPGroupBox = Tabs.Visuals:AddRightGroupbox("ESP", "boxes")


-- toggles and stuff --

getgenv().WalkSpeedSlider = 2
WalkSpeedGroupBox:AddSlider("WalkspeedSlider", {
	Text = " ",
	Default = 2,
	Min = 2,
	Max = 100,
	Rounding = 1,
	Compact = false,

	Callback = function(Value)
		
	end,

	Disabled = false, -- Will disable the slider (true / false)
	Visible = true, -- Will make the slider invisible (true / false)
})



Options.WalkspeedSlider:OnChanged(function()
	getgenv().WalkSpeedSlider = Options.WalkspeedSlider.Value
end)



WalkSpeedGroupBox:AddToggle("EnablewalkspeedToggle", {
	Text = "Enable Walkspeed",
	Tooltip = "Enables Walkspeed", -- Information shown when you hover over the toggle
	DisabledTooltip = "Enables Walkspeed", -- Information shown when you hover over the toggle while it's disabled

	Default = false, -- Default value (true / false)
	Disabled = false, -- Will disable the toggle (true / false)
	Visible = true, -- Will make the toggle invisible (true / false)
	Risky = false, -- Makes the text red (the color can be changed using Library.Scheme.Red) (Default value = false)

	Callback = function(Value)
		
	end,
})



local WalkSpeedLoop
Toggles.EnablewalkspeedToggle:OnChanged(function()
	if Toggles.EnablewalkspeedToggle.Value then
		WalkSpeedLoop = RunService.RenderStepped:Connect(function()
			Hum.WalkSpeed = getgenv().WalkSpeedSlider
			if getgenv().CrouchSpoof then
				RemotesFolder.Crouch:FireServer(true, true)
			else
				RemotesFolder.Crouch:FireServer(false, true)
			end
		end)
	else
		if WalkSpeedLoop then
			WalkSpeedLoop:Disconnect()
			WalkSpeedLoop = nil
		end

		Hum.WalkSpeed = 15
	end
end)



WalkSpeedGroupBox:AddToggle("NoAccelerationToggle", {
	Text = "No Acceleration",
	Tooltip = "Makes you accelerate instantly",
	DisabledTooltip = "Makes you accelerate instantly",

	Default = false,
	Disabled = false,
	Visible = true,
	Risky = false,

	Callback = function(Value)
		
	end,
})



local NoAccelLoop
local oldCPP = Hrp.CustomPhysicalProperties
Toggles.NoAccelerationToggle:OnChanged(function()
	if Toggles.NoAccelerationToggle.Value then
		NoAccelLoop = RunService.RenderStepped:Connect(function()
			Hrp.CustomPhysicalProperties = PhysicalProperties.new(10, 0.7, 0)
		end)
	else
		if NoAccelLoop then
			NoAccelLoop:Disconnect()
			NoAccelLoop = nil
		end

		Hrp.CustomPhysicalProperties = oldCPP
	end
end)



