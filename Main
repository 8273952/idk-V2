local ObjDescendantChecker
Toggles.ObjectiveESPToggle:OnChanged(function()
	if Toggles.ObjectiveESPToggle.Value then
		for _, Obj in ipairs(Rooms:GetDescendants()) do
			if ObjectiveNames[Obj.Name] then
				ESPLibrary:AddESP({
					Object = Obj,
					Text = ObjectiveNames[Obj.Name],
					Color = Color3.fromRGB(0, 255, 0)
				})
			end
		end

		ObjDescendantChecker = Rooms.DescendantAdded:Connect(function(Obj)
			if ObjectiveNames[Obj.Name] then
				ESPLibrary:AddESP({
				Object = Obj,
				Text = ObjectiveNames[Obj.Name],
				Color = Color3.fromRGB(0, 255, 0)
				})
			end
		end)
	else
		if ObjDescendantChecker then
			ObjDescendantChecker:Disconnect()
			ObjDescendantChecker = nil
		end

		for _, Obj in ipairs(Rooms:GetDescendants()) do
			if ObjectiveNames[Obj.Name] then
				ESPLibrary:RemoveESP(Obj)
			end
		end
	end
end)



